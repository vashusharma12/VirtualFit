# Copy to server/.env. The server also runs with no .env in development.
PORT=4000
NODE_ENV=development

# REQUIRED in production. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# In development, a temporary secret is generated, so sessions reset when the server restarts.
JWT_SECRET=

# Origin allowed to call the API with cookies (only needed if the frontend is on a different origin).
CLIENT_ORIGIN=http://localhost:5173

# Where uploaded photos are stored (private, never served as static files). Defaults to server/storage
# STORAGE_DIR=

# SQLite file. Defaults to server/data/virtualfit.db
# DB_PATH=

# Product link analyzer. The User-Agent sent when fetching product pages (a normal browser string by default).
# ANALYZER_USER_AGENT=
# Development/testing ONLY: lets the analyzer fetch from localhost. The server refuses to start with this in production.
# ANALYZER_ALLOW_PRIVATE_HOSTS=true

# Virtual try-on. 'simulated' (default) needs no key and does not use AI: it makes a clearly labelled
# side-by-side preview. 'replicate' is an untested adapter for a real try-on model.
# TRYON_PROVIDER=simulated
# TRYON_SIM_DELAY_MS=1200
# Unsaved try-on results are deleted after this many hours.
# TRYON_RETENTION_HOURS=24
# REPLICATE_API_TOKEN=
# REPLICATE_MODEL_VERSION=

# Optional: read size charts that are pictures or scripted widgets, and screenshots users upload.
# Chart pictures are sent to Anthropic's API using this key. The key stays on the server.
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5

# The "Size chart" browser step is ON by default (npm install downloads the browser, about 150 MB, once).
# It opens the Size chart button on stores that only load the chart on click (Myntra, Flipkart and many others).
# Switch it off with:
# ANALYZER_USE_BROWSER=false
# Only if the browser fails to start inside a container:
# ANALYZER_BROWSER_NO_SANDBOX=true

# "Continue with Google" sign-in. Free. Create a Client ID at https://console.cloud.google.com/ (see the README).
# GOOGLE_CLIENT_ID=1234567890-abcdefg.apps.googleusercontent.com
